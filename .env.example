# ============================================================
# Variáveis do stack — copie de .env.example e preencha.
# Este arquivo tem SENHA REAL e está no .gitignore.
#
# Para voltar ao broker público (plano B):
#   cp .env.publico .env && docker compose up -d --force-recreate
# ============================================================

# ---- PostgreSQL --------------------------------------------
POSTGRES_DB=reservatorio
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot123
POSTGRES_PORT=5432

# ---- MQTT: prefixo dos tópicos do projeto -------------------
MQTT_PREFIXO=catolicasc-g4/reservatorio

# ---- MQTT: broker remoto (destino da bridge de saída) -------
MQTT_REMOTE_HOST=seu-cluster.s1.eu.hivemq.cloud
MQTT_REMOTE_PORT=8883

# TLS: obrigatório no HiveMQ Cloud (não existe porta sem
# criptografia). Deixe "false" para o broker público.
MQTT_REMOTE_TLS=true

# Credenciais do cluster. Vazias = conexão anônima (broker público).
MQTT_REMOTE_USER=esp32
MQTT_REMOTE_PASS=troque-aqui

# ID único desta bridge no broker remoto
MQTT_BRIDGE_CLIENT_ID=catolicasc-g4-bridge-a7f3

# Porta do Mosquitto local exposta no host
MQTT_LOCAL_PORT=1883

# ---- Regra de amostragem da tabela "leituras" ---------------
AMOSTRAGEM_INTERVALO_S=30
AMOSTRAGEM_DELTA_NIVEL=5

# ---- pgAdmin (interface web do banco) -----------------------
PGADMIN_EMAIL=admin@reservatorio.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ---- Fuso horário dos containers ----------------------------
# Sem isso os logs e o banco saem em UTC (3 h à frente).
TZ=America/Sao_Paulo
