
# ---- PostgreSQL --------------------------------------------
POSTGRES_DB=reservatorio
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot123
POSTGRES_PORT=5432

# ---- MQTT: prefixo dos tópicos do projeto -------------------
# Usado tanto pela bridge do Mosquitto quanto pelo coletor.
# Troque aqui quando migrar do broker público para um local.
MQTT_PREFIXO=catolicasc-g4/reservatorio

# ---- MQTT: broker remoto (destino da bridge de saída) -------
MQTT_REMOTE_HOST=broker.hivemq.com
MQTT_REMOTE_PORT=1883
# O broker público derruba clients com o mesmo ID — troque o
# sufixo por algo único seu antes da demonstração.
MQTT_BRIDGE_CLIENT_ID=catolicasc-g4-bridge-a7f3

# Porta do Mosquitto local exposta no host (cliente MQTT)
MQTT_LOCAL_PORT=1883

# ---- Regra de amostragem da tabela "leituras" ---------------
# Grava no máximo uma linha a cada N segundos...
AMOSTRAGEM_INTERVALO_S=30
# ...exceto se o nível variar mais que este tanto (pontos %),
# caso em que grava na hora.
AMOSTRAGEM_DELTA_NIVEL=5

# ---- Compatibilidade com o template atual -------------------
# Broker público é anônimo e sem TLS: variáveis vazias fazem o
# docker-compose omitir bridge_cafile e as credenciais.
MQTT_REMOTE_TLS=false
MQTT_REMOTE_USER=
MQTT_REMOTE_PASS=

# ---- pgAdmin (interface web do banco) -----------------------
PGADMIN_EMAIL=admin@reservatorio.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ---- Fuso horário dos containers ----------------------------
# Sem isso os logs e o banco saem em UTC (3 h à frente).
TZ=America/Sao_Paulo
